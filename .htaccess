# VOSTOKPRIBOR Root .htaccess
# Production Apache 2.4 Configuration

# Disable directory browsing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>

# Block .git directory access with 404
<IfModule mod_alias.c>
    RedirectMatch 404 (^|/)\.git
</IfModule>

# Block access to hidden files and dotfiles (e.g. .env, .git, .gitignore)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block sensitive and administrative file extensions
<FilesMatch "(?i)\.(sql|log|bak|md|rar|zip|tar|gz|7z|env.*|ini|sh|bat)$">
    Require all denied
</FilesMatch>

# Block specific sensitive files
<Files "phpinfo.php">
    Require all denied
</Files>
