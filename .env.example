# VOSTOKPRIBOR Enterprise Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# NEVER put real secrets or passwords in this file.

# ----- Database -----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vostokpribor

# Use the least-privilege application user, NOT root.
# Create via: DataBase/migrations/008_security_and_fk.sql
# Then set the real password here (not CHANGE_THIS_IN_ENV).
DB_USER=vostok_app
DB_PASS=CHANGE_THIS_IN_ENV

# ----- SSO Secret (min 32 chars, rotate regularly) -----
VOSTOK_SSO_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHARACTER_STRING_MINIMUM_32_CHARS

# ----- App Environment -----
# Set to 'local' only on developer machines.
# Production: 'production'. Test: 'test'.
APP_ENV=production

# ----- SuperAdmin Password (tests only) -----
# The plaintext password for EMP-0001 (admin@gmail.com).
# Used ONLY by the test suite — never written to any seed file or code.
# Must be set before running tests/test_all_acceptance.php.
# Generate hash via: php -r "echo password_hash(getenv('TEST_ADMIN_PASSWORD'), PASSWORD_BCRYPT, ['cost'=>12]);"
# Then store the hash in employee_accounts via scripts/set_admin_password.php
TEST_ADMIN_PASSWORD=CHANGE_THIS_TO_REAL_ADMIN_PASSWORD

# ----- Test Database -----
# Separate database used by the test suite (APP_ENV=test).
# Never run tests against the production database.
TEST_DB_NAME=vostokpribor_test
