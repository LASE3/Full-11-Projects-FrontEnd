# ==============================================================================
# VOSTOKPRIBOR ENTERPRISE PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env on production hosts.
# Ensure file permissions are strictly locked: chmod 600 .env (chown www-data:www-data).
# NEVER commit the active .env to version control.
# NEVER run in production with default secrets or root database credentials.
# ==============================================================================

# ----- Application Environment -----
APP_ENV=production

# ----- Error Reporting & Information Disclosure -----
# In production, error display must remain disabled to prevent leaking stack traces or credentials.
display_errors=off
display_startup_errors=off
expose_php=off

# ----- Transport Security (Mandatory HTTPS) -----
# Production MUST be served exclusively over TLS 1.3 / HTTPS.
# All session cookies (PHPSESSID) and SSO tokens (vostok_sso_token) enforce the 'Secure' attribute.
# When behind reverse proxies (Nginx / HAProxy / Cloudflare), pass X-Forwarded-Proto: https
# and enforce HSTS (Strict-Transport-Security: max-age=31536000; includeSubDomains).
REQUIRE_HTTPS=true
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# ----- Database (Least-Privilege Non-Root User) -----
# The production application MUST NOT run as 'root'.
# Create the dedicated least-privilege 'vostok_app' user with only necessary DML permissions:
#
#   CREATE USER 'vostok_app'@'localhost' IDENTIFIED BY 'STRONG_SECRET_PASSWORD';
#   GRANT SELECT, INSERT, UPDATE, DELETE, EXECUTE ON vostokpribor.* TO 'vostok_app'@'localhost';
#   FLUSH PRIVILEGES;
#
# 'vostok_app' has NO DROP, NO GRANT OPTION, NO SUPER, and NO SHUTDOWN capabilities.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vostokpribor
DB_USER=vostok_app
DB_PASS=CHANGE_TO_A_COMPLEX_64_CHARACTER_RANDOM_PASSWORD

# ----- Cryptographic SSO Authentication Token Secret -----
# Cryptographically secure random secret (minimum 32 characters, recommend 64-character hex).
# Generate via: php -r "echo bin2hex(random_bytes(32));"
VOSTOK_SSO_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_64_CHAR_HEX_TOKEN_DO_NOT_REUSE

# ----- Session Configuration -----
SESSION_LIFETIME=28800
